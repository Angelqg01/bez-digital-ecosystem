{
  "name": "bezhas-backend",
  "version": "1.0.0",
  "description": "Secure backend for BeZhas Web3 social network",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "chat": "node chat/chat-server.js",
    "chat:dev": "nodemon chat/chat-server.js",
    "test": "jest --env=node",
    "test:watch": "jest --env=node --watch",
    "test:coverage": "jest --env=node --coverage",
    "test:ci": "jest --env=node --config jest.ci.config.js --ci",
    "test:unit": "jest --env=node --testPathPattern=tests/(?!integration)",
    "test:integration": "jest --env=node --testPathPattern=tests/integration",
    "test:db": "jest --env=node tests/database-connection.test.js",
    "test:payments": "jest --env=node tests/payment-flow-e2e.test.js",
    "test:e2e:polygon-crypto": "node tests/polygon-crypto-payment.e2e.js",
    "test:all": "pnpm run test:db && pnpm run test:payments",
    "test:chat": "node chat/test-chat-integration.js",
    "lint": "eslint . --ext .js",
    "check-updates": "pnpm outdated",
    "update-safe": "pnpm update",
    "clean": "rm -rf node_modules && pnpm install",
    "seed:dao": "node seeds/daoSeed.js",
    "health": "curl -s http://localhost:3000/api/health | node -e \"console.log(JSON.parse(require('fs').readFileSync('/dev/stdin').toString()))\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^22.0.1",
    "@otplib/preset-default": "^12.0.1",
    "@react-oauth/google": "^0.13.4",
    "@simplewebauthn/server": "^14.0.3",
    "arweave": "^2.1.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.10",
    "chromadb": "^3.3.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "express-pino-logger": "^7.0.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.5",
    "gcp-metadata": "^9.0.4",
    "glob": "^13.0.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "multer": "^2.0.2",
    "nanoid": "^6.0.1",
    "natural": "^8.1.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "openai": "^7.25.0",
    "otplib": "^13.2.1",
    "path-to-regexp": "8.4.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rss-parser": "^3.13.0",
    "siwe": "^3.0.0",
    "speakeasy": "^2.0.0",
    "stripe": "^22.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2",
    "validator": "^13.11.0",
    "winston": "^3.19.0",
    "ws": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "blockchain",
    "web3",
    "social-network",
    "security"
  ],
  "author": "BeZhas Team",
  "license": "MIT",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "pnpm": ">=11"
  }
}
