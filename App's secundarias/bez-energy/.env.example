# BeZhas Energy (VPP) — local development
# Copy to .env.local and adjust. Vite exposes only VITE_*-prefixed vars.

# Core API gateway (must include the /api suffix — api.js appends /energy)
VITE_API_URL=http://localhost:3001/api

# Blockchain RPC for direct on-chain reads (energy sector contracts)
VITE_RPC_URL=http://localhost:8545
VITE_CHAIN_ID=31337

# Keep the simulated dashboard data when the backend is unreachable.
# Dev: always on. Production: set "true" only for public demos.
VITE_ALLOW_SIMULATED_FALLBACK=true
