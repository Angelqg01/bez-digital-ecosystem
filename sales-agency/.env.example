# ── Claude API ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail (para enviar emails) ─────────────────────────────────
# Usa una "App Password" de Google, no tu contraseña normal
# Activar en: myaccount.google.com/apppasswords
GMAIL_USER=info.angelqg@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Telegram (para reportes) ───────────────────────────────────
# BotFather → /newbot → copiar token
TELEGRAM_BOT_TOKEN=your_bot_token
# Tu chat_id personal (escribe /start a @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id

# ── Config campaña ─────────────────────────────────────────────
# Precio actual del token
BEZ_PRICE_USD=0.0075
# URL de venta
BEZ_SALE_URL=https://bez.digital/token/buy
# Email para que respuestas lleguen aquí
REPLY_TO_EMAIL=info.angelqg@gmail.com

# ── Límites diarios (para no quemar cuentas) ──────────────────
MAX_EMAILS_PER_DAY=30
MAX_LEADS_PER_SCOUT=5
