# ─── OPERANT — Variables de entorno ───────────────────────────
# Copia este archivo como .env y rellena los valores.

# Modelos IA (sin clave = modo SIMULADO para desarrollo)
ANTHROPIC_API_KEY=

# Motor local gratuito (Ollama). Con USE_OLLAMA=true los tiers pueden apuntar
# a modelos locales; en máquinas de 8 GB usa qwen2.5:3b (con tool-use):
#   ollama pull qwen2.5:3b && ollama pull nomic-embed-text
# USE_OLLAMA=true
# OLLAMA_URL=http://localhost:11434
# TIER_FRONTIER_PROVIDER=ollama   # o anthropic si hay crédito (mejor calidad)
# TIER_FRONTIER_MODEL=qwen2.5:3b
# TIER_MID_PROVIDER=ollama
# TIER_MID_MODEL=qwen2.5:3b
# TIER_FAST_PROVIDER=ollama
# TIER_FAST_MODEL=qwen2.5:3b

# API
PORT=4000
INTERNAL_API_KEY=cambia-esto-por-una-clave-segura   # clave ADMIN (acceso a todos los tenants)
SIGNUP_SECRET=                                        # opcional: protege POST /signup

# Datos. Por defecto el server usa SQLite embebido (data/operant.db):
# tenants, claves de API, memoria y auditoría sobreviven a reinicios sin
# infraestructura. SQLITE_PATH=memory fuerza el modo RAM (tests/efímero).
# SQLITE_PATH=data/operant.db
# Con DATABASE_URL se usa Postgres (producción multi-nodo; antes: npm run db:up
# y npm run db:migrate). Conéctate SIEMPRE con el rol de aplicación operant_app:
# el rol dueño (POSTGRES_USER) es superusuario y se salta la Row-Level Security,
# es decir, deja de haber aislamiento entre empresas cliente. PostgresStore se
# niega a arrancar si detecta ese caso. Ver docs/MULTI-TENANCY.md.
# DATABASE_URL=postgres://operant_app:CAMBIA_ESTO@localhost:5432/operant
# PG_APP_PASSWORD=              # solo para `npm run db:migrate`: fija la del rol
# Dimensión de los vectores de memoria. Debe coincidir con el modelo de
# embeddings y con la columna interactions.embedding (por defecto 768,
# nomic-embed-text). Cambiarla exige un ALTER TABLE — connect() lo indica.
# EMBEDDING_DIMS=768
# REDIS_URL=redis://localhost:6379
# VECTOR_DB_URL=

# Correo. OJO: definir SMTP_HOST hace que el conector deje de estar en modo
# simulado, así que debe apuntar a un servidor que EXISTA. Si no responde, el
# canal queda degradado (visible en /healthz) y ningún envío se da por hecho —
# pero tampoco sale. Sin SMTP_HOST ni RESEND_API_KEY → simulado honesto.
# Puesta en pie del correo propio: docs/CORREO-PROPIO.md

# Canales (sin claves = simulado: parsea entrada y registra la salida en consola)
# Telegram — crea un bot con @BotFather y apunta el webhook a
#   /channels/telegram/<tenantId>/inbound
TELEGRAM_BOT_TOKEN=            # bot de marketing (canal marketing + fallback HITL)
TELEGRAM_CFO_BOT_TOKEN=        # bot financiero (avisos HITL del dpto. finanzas)
TELEGRAM_WEBHOOK_SECRET=        # opcional, cabecera secreta del webhook
HITL_TELEGRAM_CHAT_ID=         # chat que recibe las aprobaciones HITL

# HITL: timeout y escalado. 0 = desactivado (espera indefinida, sin 2º aviso).
# Si se agota HITL_TIMEOUT_MS sin respuesta, la acción se cancela sola (nunca
# se ejecuta por silencio). HITL_ESCALATE_AFTER_MS (debe ser menor que el
# timeout) manda un 2º aviso SIEMPRE al bot de fallback (el CEO), antes de
# llegar al timeout duro.
# HITL_TIMEOUT_MS=14400000        # 4h
# HITL_ESCALATE_AFTER_MS=3600000  # 1h

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=                 # token de acceso permanente
WHATSAPP_PHONE_NUMBER_ID=       # id del número emisor
WHATSAPP_VERIFY_TOKEN=          # token para el handshake GET del webhook

# Email saliente. Dos vías (la primera disponible gana):
#  a) Resend (HTTP, sin dependencias):
RESEND_API_KEY=
EMAIL_FROM=                     # remitente verificado, p.ej. ventas@tudominio.com
#  b) SMTP propio (nodemailer ya instalado; Stalwart u otro):
# SMTP_HOST=mail.tudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@tudominio.com
# (El OutreachAgent redacta y el envío en frío SIEMPRE pasa por HITL antes de salir.)

# Cobros con Stripe (sin clave = simulado). El conector SOLO emite enlaces de
# cobro y consulta facturas/suscripciones: NUNCA mueve fondos (línea roja).
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=eur

# CRM propio: Twenty (open source, auto-alojado). Sin esto → simulado.
# TWENTY_API_URL=http://localhost:3000
# TWENTY_API_KEY=

# Agenda: Cal.com (v2). Sin esto → simulado.
# CALENDAR_API_KEY=
# CALCOM_EVENT_TYPE_ID=
# CALENDAR_TZ=Europe/Madrid

# Almacén de objetos propio: MinIO (S3-compatible). Sin MINIO_ENDPOINT → simulado
# en RAM. Requiere el SDK: npm i minio
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=operant
# MINIO_SECRET_KEY=operant-secret
# MINIO_BUCKET=operant

# Automatización propia: n8n (pegamento de eventos). Sin N8N_API_URL → simulado.
# La API key se crea en n8n: Settings → n8n API → Create an API key.
# OJO: un workflow puede hacer cualquier cosa. Endurece la política del tenant con
#   PUT /tenants/:id/policies/automation  {"rule":"always_approve"}
# N8N_API_URL=http://localhost:5678
# N8N_API_KEY=
# N8N_WEBHOOK_URL=http://localhost:5678   # si el webhook sale por otro host/túnel
# N8N_ENCRYPTION_KEY=cambia-esto

# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn — publicación en el feed del miembro
# ─────────────────────────────────────────────────────────────────────────────
# Alcance real de la API auto-servicio (sin LinkedIn Partner Program):
#   ✅ Publicar en el feed del MIEMBRO autenticado  (scope w_member_social)
#   ✅ Identidad del miembro                        (scopes openid, profile, email)
#   ❌ Buscar personas/empresas, leer contactos, enviar InMail  → NO existe
#      endpoint self-serve. Para captar por LinkedIn se publica contenido con
#      enlaces UTM al formulario web y los recoge LinkedInInboundSource.
#
# Sin LINKEDIN_ACCESS_TOKEN el conector va en modo simulado (no toca la red).
#
# LINKEDIN_CLIENT_ID=78lcuevb7w1l51
#
# ⚠ PENDIENTE DE ROTAR: el secret actual se compartió en texto plano en una
#   conversación. Mientras no se rote, cualquiera con acceso a ese historial
#   puede pedir tokens en nombre de la app. Rotación:
#     LinkedIn Developer Portal → tu app → Auth → Client Secret → Regenerate.
#   Al rotarlo, actualiza solo el .env local (este archivo NO lleva secretos).
# LINKEDIN_CLIENT_SECRET=
#
# Token de acceso del miembro (OAuth 3-legged, caduca a los ~60 días).
# LINKEDIN_ACCESS_TOKEN=
# Opcional: si no se indica, se resuelve por OIDC (/v2/userinfo → sub).
# LINKEDIN_MEMBER_URN=urn:li:person:XXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# Captación de leads (endpoint público + webhooks de resultados)
# ─────────────────────────────────────────────────────────────────────────────
# POST /intake/:tenantId es el ÚNICO endpoint que escribe sin API key: lo llama
# el formulario público de la web. Envíos por IP y minuto antes de cortar (429).
# INTAKE_MAX_PER_MINUTE=5

# POST /webhooks/leads/:tenantId — resultados (respondió, reunión, cerrado) que
# reentrenan los pesos del embudo. Firma HMAC-SHA256 en la cabecera x-signature.
# SIN ESTE SECRETO EL ENDPOINT DEVUELVE 503 A PROPÓSITO: abierto permitiría a
# cualquiera envenenar el aprendizaje del funnel.
#   Generar:  openssl rand -hex 32
# LEADS_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# CSAT — satisfacción del cliente final (única métrica de Soporte no interna)
# ─────────────────────────────────────────────────────────────────────────────
# El tenant pide el enlace con POST /tenants/:id/support/csat/issue (con API key)
# y el cliente responde en POST /csat/:token SIN API key: le autoriza el token
# firmado, no una cabecera. El token caduca a los 14 días y solo admite un voto
# por ticket.
#   Generar:  openssl rand -hex 32
# CSAT_SECRET=
# PUBLIC_BASE_URL=https://api.bezhas.io   # para construir el enlace del correo
# CSAT_MAX_PER_MINUTE=10

# ─────────────────────────────────────────────────────────────────────────────
# Observabilidad de LLM: Langfuse (self-hosted, ver infra/docker-compose.full.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Traza cada llamada al modelo (prompt, respuesta, tokens, tenant, agente) para
# poder depurar producción y detectar regresiones de prompt. Sin las 3 variables
# de abajo, LangfuseExporter no hace nada (ni intenta red) — igual que el resto
# de conectores sin credenciales.
#
# 1) Levanta el servicio (perfiles core + observability, requiere los secretos
#    de más abajo en este mismo .env — ver docs/OBSERVABILIDAD-LANGFUSE.md):
#      docker compose -f infra/docker-compose.full.yml --profile core --profile observability up -d
# 2) Crea la base de datos dedicada la primera vez:
#      docker exec -it operant-postgres-1 psql -U operant -c 'CREATE DATABASE langfuse;'
# 3) Entra en http://localhost:3400, crea la organización/proyecto y copia las
#    claves pública/secreta (Settings → API Keys) a las dos variables de abajo.
#
# LANGFUSE_BASE_URL=http://localhost:3400
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_FLUSH_INTERVAL_MS=10000

# Secretos SOLO para desplegar el propio servicio Langfuse (infra/docker-compose.full.yml).
# No son credenciales de la app: son la configuración interna de Langfuse (cifrado
# de datos en reposo, sesión del panel web, contraseña de su ClickHouse). Genera
# cada uno con `openssl rand -hex 32`; sin ellos el `docker compose` no arranca
# a propósito (mejor fallar al desplegar que arrancar con secretos por defecto).
# CLICKHOUSE_PASSWORD=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=

# Demo
DEMO_TENANT=true
