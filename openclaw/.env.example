# ═══════════════════════════════════════════════════════════════
# BeZhas OpenClaw — Variables de Entorno
# Copia este archivo como .env y rellena tus keys
# NUNCA subas el .env real a Git
# ═══════════════════════════════════════════════════════════════

# ── API Keys de LLMs (cadena de fallback OpenClaw) ────────────
ANTHROPIC_API_KEY=sk-ant-...         # Claude (proveedor primario)
GOOGLE_API_KEY=AIza...               # Gemini 2.0 Flash (fallback #2)
OPENAI_API_KEY=sk-...                # GPT-4o (fallback #3)
DEEPSEEK_API_KEY=sk-...              # DeepSeek V3 (fallback #4)

# ── BeZhas Blockchain ─────────────────────────────────────────
BEZ_CONTRACT_POLYGON=0xEcBa873B534C54DE2B62acDE232ADCa4369f11A8
BEZ_CONTRACT_BNB=0x8a1e3930fde1f151471c368fdbb39f3f63a65b55
TREASURY_DAO=0x89c23890c742d710265dD61be789C71dC8999b12
HOT_WALLET=0x52Df82920CBAE522880dD7657e43d1A754eD044E

# ── RPC Nodes ─────────────────────────────────────────────────
RPC_BNB=https://bsc-dataseed.binance.org
RPC_POLYGON=https://polygon-rpc.com

# ── Motor de cuantización ──────────────────────────────────────
QUANT_PRECISION=int4_bnb             # int4_bnb | int8_bnb | Q3_K_M | api
DEVICE_MAP=auto                      # auto | cpu | cuda:0
MAX_MEMORY_GB=24                     # 24 para RTX 4090

# ── Servidor ──────────────────────────────────────────────────
BEZHAS_ENV=production
LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0
