# ═══════════════════════════════════════════════════════════════════════════
# BeZhas — Plantilla de Secretos de Producción (EJEMPLO - NO EJECUTABLE)
# ═══════════════════════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
# 1. Copia este archivo a ~/.bezhas/.env.production
# 2. Reemplaza TODOS los valores con los reales
# 3. Ejecuta chmod 600 ~/.bezhas/.env.production
# 4. Ejecuta ./deploy/gcp/02-secrets.sh ~/.bezhas/.env.production
#
# NUNCA:
#  - Versionues .env.production en Git
#  - Pasees valores por línea de comandos
#  - Compartas este archivo por email/Slack
#
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# 🔐 SEGURIDAD Y AUTENTICACIÓN
# ─────────────────────────────────────────────────────────────────────────

# JWT para autenticación de usuarios (generar con: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-32-characters-minimum-here

# Cookie secret para sesiones (generar con: openssl rand -base64 32)
COOKIE_SECRET=your-cookie-secret-32-characters-minimum-here

# Token de administrador (generar con: openssl rand -hex 32)
ADMIN_TOKEN=your_admin_token_long_random_string_here

# Clave de cifrado para datos sensibles (base64, 32+ bytes)
CONTACT_ENCRYPTION_KEY=your-base64-encoded-encryption-key-32-bytes-minimum

# Orígenes CORS permitidos (separados por coma)
ALLOWED_ORIGINS=https://www.bezhas.com,https://api.bezhas.com,https://mcp.bezhas.com

# ─────────────────────────────────────────────────────────────────────────
# 🔑 OAUTH 2.1 (Par ES256 - CRÍTICO)
# ─────────────────────────────────────────────────────────────────────────
# Generar claves con:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt > priv.pem
#   openssl ec -in priv.pem -pubout > pub.pem
#   base64 -w0 priv.pem | xclip  (copiar privada)
#   base64 -w0 pub.pem | xclip   (copiar pública)
#
# En .env.production: todo en UNA LÍNEA (base64 de UNA línea)

OAUTH_JWT_PRIVATE_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tTUlHSEFnRUFNQk0...
OAUTH_JWT_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS1NSUdUTUE0R0NT...

# ─────────────────────────────────────────────────────────────────────────
# 🌐 RPC URLs (Blockchain / Nodos)
# ─────────────────────────────────────────────────────────────────────────

# Polygon Mainnet (Chain 137) - PRODUCCIÓN
# Opciones:
#   - Pública: https://polygon-rpc.com (con rate limiting)
#   - Alchemy: https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
#   - Infura: https://polygon-mainnet.infura.io/v3/YOUR_KEY
#   - QuickNode: https://proud-shy-wind.matic.quiknode.pro/...
POLYGON_RPC_URL=https://polygon-rpc.com

# BeZhas L2 - Tu cadena personalizada (o testnet)
# Ejemplos:
#   - http://localhost:8545 (desarrollo local)
#   - https://testnet-l2.bezhas.com:8545 (testnet privado)
#   - https://rpc.bezhas.io (producción)
BEZHAS_L2_RPC_URL=https://l2.bezhas.com/rpc

# RPC fallback (si BEZHAS_L2_RPC_URL no está disponible)
RPC_URL=https://polygon-rpc.com

# ─────────────────────────────────────────────────────────────────────────
# 👤 WALLETS Y OPERADORES (DEDICADOS - BAJO BALANCE)
# ─────────────────────────────────────────────────────────────────────────
#
# ⚠️  CRÍTICO:
#   - Cada clave debe ser ÚNICA (no compartas entre roles)
#   - Cada wallet debe tener BAJO BALANCE (ej: 0.5 MATIC, no 100)
#   - NUNCA uses wallets de tesoro/producción como operador
#   - Asigna MÍNIMOS permisos en contratos inteligentes
#
# Generar con:
#   openssl rand -hex 32 | sed 's/^/0x/'

# Relayer de transacciones sin gas (opcional)
# Si no lo configuras, el backend corre en modo SOLO LECTURA
RELAYER_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
RELAYER_ADDRESS=0x1234567890123456789012345678901234567890

# Operador del nodo (valida y ejecuta transacciones)
OPERATOR_PRIVATE_KEY=0x2222222222222222222222222222222222222222222222222222222222222222
OPERATOR_ADDRESS=0x0987654321098765432109876543210987654321

# Agente inteligente (ejecuta contratos automáticamente)
AGENT_PRIVATE_KEY=0x3333333333333333333333333333333333333333333333333333333333333333
AGENT_ADDRESS=0xabcdefabcdefabcdefabcdefabcdefabcdefabcd

# Edge Node (procesamiento descentralizado)
EDGE_NODE_PRIVATE_KEY=0x4444444444444444444444444444444444444444444444444444444444444444
EDGE_NODE_ADDRESS=0xfedcbafedcbafedcbafedcbafedcbafedcbafed

# ─────────────────────────────────────────────────────────────────────────
# 📜 CONTRATOS INTELIGENTES (Direcciones públicas, no secretas)
# ─────────────────────────────────────────────────────────────────────────

# Token BEZ (direccion del contrato en Polygon)
BEZCOIN_CONTRACT_ADDRESS=0xEcBa873B534C54DE2B62acDE232ADCa4369f11A8

# Contrato central
CORE_CONTRACT_ADDRESS=0x0C4291c40Aaaded2207b3C3118B6afc9cc10EBE7

# Gobernanza
GOVERNANCE_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Farming/Staking
FARMING_CONTRACT_ADDRESS=0x2345678901234567890123456789012345678901

# Marketplace
MARKETPLACE_CONTRACT_ADDRESS=0x3456789012345678901234567890123456789012

# Garantía de calidad
QUALITY_ESCROW_ADDRESS=0x5101ab251f17F8948069b74fd59eCf2C150b29EF
QUALITY_ORACLE_ADDRESS=0x0C4291c40Aaaded2207b3C3118B6afc9cc10EBE7

# ─────────────────────────────────────────────────────────────────────────
# 💰 WALLETS DE TESORERÍA (Alto valor - máxima seguridad)
# ─────────────────────────────────────────────────────────────────────────

# Billetera del tesoro (múltiples firmas recomendado)
TREASURY_WALLET=0xTreasuryMultisig123456789012345678901234

# Billetera comunitaria
COMMUNITY_WALLET=0xCommunityWallet1234567890123456789012345

# Billeteras de súper administrador (separadas por coma)
SUPER_ADMIN_WALLETS=0xAdmin1Wallet123456789012345678901234,0xAdmin2Wallet123456789012345678901234

# Billeteras de administrador general
ADMIN_WALLETS=0xAdminWallet11234567890123456789012345,0xAdminWallet21234567890123456789012345

# ─────────────────────────────────────────────────────────────────────────
# 📊 BASES DE DATOS
# ─────────────────────────────────────────────────────────────────────────

# ⚠️  DATABASE_URL NO va en este archivo
#     Lo genera 01b-database.sh directamente en Secret Manager
#     (es la conexión a Cloud SQL, solo admin accede)

# MongoDB (opcional, para Developer Console y SDK Admin)
# Si no configuras, el backend arranca sin estas features
MONGODB_URI=mongodb+srv://bezhas_prod_user:your_secure_password@cluster.mongodb.net/bezhas?retryWrites=true&w=majority

# Redis (opcional, para caché y rate limiting)
# Si no configuras, usa memoria en proceso (menos eficiente)
REDIS_URL=rediss://default:your_redis_password@redis-instance.c123.us-east-1-2.ec2.cloud.redislabs.com:18123

# ─────────────────────────────────────────────────────────────────────────
# 📧 EMAIL / SMTP
# ─────────────────────────────────────────────────────────────────────────

# Servidor SMTP (Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Credenciales SMTP
# Para Gmail: usar contraseña de aplicación, no la de cuenta
SMTP_USER=noreply@bezhas.com
SMTP_PASS=your_app_password_16_chars_minimum

# ─────────────────────────────────────────────────────────────────────────
# 💳 STRIPE (Pagos)
# ─────────────────────────────────────────────────────────────────────────

# Clave secreta (live, no test) - REEMPLAZAR CON TU CLAVE REAL
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here_replace_with_real_value

# Webhook signature (para verificar hooks desde Stripe) - REEMPLAZAR CON TU VALOR REAL
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here_replace_with_real_value

# ─────────────────────────────────────────────────────────────────────────
# 🏦 WEBHOOKS (Bank integrations, notificaciones externas)
# ─────────────────────────────────────────────────────────────────────────

# Secret para firmar y verificar webhooks de integraciones bancarias
# Generar con: openssl rand -base64 32
BANK_WEBHOOK_SECRET=your_bank_webhook_secret_here_replace_with_real_value

# ─────────────────────────────────────────────────────────────────────────
# 🔐 OAUTH TERCEROS (Google, GitHub, LinkedIn)
# ─────────────────────────────────────────────────────────────────────────

# Google OAuth (para login con Google)
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

# GitHub OAuth (para login con GitHub)
GITHUB_CLIENT_ID=Iv1.abcdef123456789
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# LinkedIn OAuth (para login con LinkedIn)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# ─────────────────────────────────────────────────────────────────────────
# 🤖 IA Y APIS EXTERNAS
# ─────────────────────────────────────────────────────────────────────────

# Google Gemini (análisis de imágenes, PDFs, etc.)
GEMINI_API_KEY=AIzaSyA_your_gemini_api_key_here_long_string

# OpenAI (GPT-4, embeddings, etc.)
OPENAI_API_KEY=sk-your_openai_api_key_here_long_string

# DeepSeek (modelos de código/razonamiento)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# GitHub Token (para acceder a repos privados desde MCP)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ─────────────────────────────────────────────────────────────────────────
# 📌 IPFS / PINATA (Almacenamiento descentralizado)
# ─────────────────────────────────────────────────────────────────────────

# Pinata - Almacenar en IPFS sin instalar nodo completo
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9eyJzdWIiOiJwaW5hdGF...

# ─────────────────────────────────────────────────────────────────────────
# 📱 NOTIFICACIONES (Optional)
# ─────────────────────────────────────────────────────────────────────────

# Telegram Bot (para alertas)
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh

# Discord Webhook (para notificaciones)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh

# ─────────────────────────────────────────────────────────────────────────
# 🔍 MCP INTELLIGENCE (APIs para análisis)
# ─────────────────────────────────────────────────────────────────────────

# FireCrawl (web scraping para MCP)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Tally Forms (formularios públicos)
TALLY_API_KEY=your_tally_api_key_here

# Alpaca (datos de mercado)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# 1Inch (agregador de DEX)
ONEINCH_API_KEY=your_1inch_api_key_here

# ═══════════════════════════════════════════════════════════════════════════
# FIN DE ARCHIVO - NO EDITAR MÁS ABAJO
