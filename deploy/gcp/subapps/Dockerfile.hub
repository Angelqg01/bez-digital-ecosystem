# BeZhas Hub (Next.js). Contexto = raíz del repo: depende de @bezhas/sdk (file:../../../sdk).
FROM node:22-alpine AS builder
RUN npm install -g pnpm@11
WORKDIR /ws
COPY sdk ./sdk
COPY App-nativas/Bezhas-Hub/frontend-next ./App-nativas/Bezhas-Hub/frontend-next
WORKDIR /ws/App-nativas/Bezhas-Hub/frontend-next
RUN pnpm install --ignore-workspace --no-frozen-lockfile --ignore-scripts
ARG VITE_API_URL=https://api.bezhas.com
ARG VITE_CHAIN_ID=137
ARG VITE_NETWORK=polygon
ARG NEXT_PUBLIC_BEZCOIN_ADDRESS=0xEcBa873B534C54DE2B62acDE232ADCa4369f11A8
ENV NEXT_PUBLIC_API_URL=$VITE_API_URL NEXT_PUBLIC_CHAIN_ID=$VITE_CHAIN_ID NEXT_PUBLIC_NETWORK=$VITE_NETWORK NEXT_PUBLIC_BEZCOIN_ADDRESS=$NEXT_PUBLIC_BEZCOIN_ADDRESS
RUN pnpm run build && mkdir -p public

FROM node:22-alpine AS production
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001 -G nodejs
COPY --from=builder /ws/App-nativas/Bezhas-Hub/frontend-next/package.json ./package.json
COPY --from=builder /ws/App-nativas/Bezhas-Hub/frontend-next/node_modules ./node_modules
COPY --from=builder /ws/App-nativas/Bezhas-Hub/frontend-next/public ./public
COPY --from=builder /ws/App-nativas/Bezhas-Hub/frontend-next/.next ./.next
# @bezhas/sdk se instala como enlace a ../../../sdk: se deja en su misma ruta relativa.
COPY --from=builder /ws/sdk /sdk
RUN chown -R nextjs:nodejs /app
USER nextjs
ENV PORT=8080 NODE_ENV=production
EXPOSE 8080
CMD ["node_modules/.bin/next", "start"]
