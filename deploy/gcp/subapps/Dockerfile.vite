# SubApps Vite (Energy, PureScan, CargoLink). Contexto = raíz del repo (ver cloudbuild-subapp.yaml):
# estas apps importan ../_shared y ../packages, hermanos de su carpeta, así que se conserva el árbol App-nativas/.
FROM node:22-alpine AS builder
ARG APP_DIR
# URL de la API que se incrusta en el JavaScript (sin esto las apps llaman a http://localhost:3001).
ARG VITE_API_URL=https://api.bezhas.com/api
ARG VITE_GATEWAY_URL=https://api.bezhas.com/api
ARG VITE_WS_URL=wss://api.bezhas.com/ws
ENV VITE_API_URL=$VITE_API_URL VITE_GATEWAY_URL=$VITE_GATEWAY_URL VITE_WS_URL=$VITE_WS_URL
RUN npm install -g pnpm@11
ENV CI=true
WORKDIR /ws
# Lo subido ya está filtrado (deploy/gcp/subapps/.gcloudignore): _shared, packages y las apps.
COPY App-nativas ./App-nativas
WORKDIR /ws/${APP_DIR}
RUN pnpm install --ignore-workspace --no-frozen-lockfile --ignore-scripts
# _shared/ no tiene node_modules: un enlace en App-nativas/ hace que react, ethers… se resuelvan desde los de la app.
RUN ln -s "/ws/${APP_DIR}/node_modules" /ws/App-nativas/node_modules
# --ignore-workspace: la subida incluye App-nativas/pnpm-workspace.yaml (para Wallet/Gas/Prestige) y estas apps NO son del workspace.
RUN pnpm --ignore-workspace run build

FROM nginx:1.27-alpine
ARG APP_DIR
COPY --from=builder ["/ws/${APP_DIR}/dist", "/usr/share/nginx/html"]
RUN printf 'server {\n\
    listen 8080;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/javascript;\n\
}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
