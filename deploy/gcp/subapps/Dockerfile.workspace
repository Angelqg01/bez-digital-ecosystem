# SubApps que declaran @bezhas/* como `workspace:*` (Wallet, Gas, Prestige). Contexto = raíz del repo.
# Hay que instalar con el workspace de App-nativas/ (pnpm-workspace.yaml) y compilar antes los paquetes
# compartidos (contracts, platform-sdk, ui-components), porque la app los importa desde su dist/.
FROM node:22-alpine AS builder
ARG APP_DIR
ARG VITE_API_URL=https://api.bezhas.com/api
ARG VITE_GATEWAY_URL=https://api.bezhas.com/api
ARG VITE_WS_URL=wss://api.bezhas.com/ws
ENV VITE_API_URL=$VITE_API_URL VITE_GATEWAY_URL=$VITE_GATEWAY_URL VITE_WS_URL=$VITE_WS_URL
RUN npm install -g pnpm@11
# Sin TTY, pnpm 11 aborta si ve que hay que reconstruir node_modules; CI=true lo hace sin preguntar.
ENV CI=true
WORKDIR /ws
COPY App-nativas ./App-nativas
WORKDIR /ws/App-nativas
# APP_DIR llega como «App-nativas/<app>»; el filtro de pnpm lo quiere relativo a App-nativas/.
# Los paquetes compartidos se seleccionan también por nombre: así se instalan SUS devDependencies (typescript, @types/react) y no solo las de producción.
RUN pnpm install --no-frozen-lockfile --ignore-scripts --filter "./${APP_DIR#App-nativas/}..." --filter @bezhas/contracts --filter @bezhas/platform-sdk --filter @bezhas/ui-components
# Los .tsbuildinfo del repo dicen «ya compilado» aunque dist/ no viaje en la subida: sin borrarlos tsc no emite nada.
RUN find packages -name '*.tsbuildinfo' -delete
# En este orden: ui-components referencia el dist de platform-sdk.
RUN pnpm --filter @bezhas/contracts run build && pnpm --filter @bezhas/platform-sdk run build && pnpm --filter @bezhas/ui-components run build
# _shared/ no tiene node_modules: un enlace a los de la app hace que react, ethers… se resuelvan desde ahí.
RUN ln -s "/ws/${APP_DIR}/node_modules" /ws/App-nativas/_shared/node_modules
WORKDIR /ws/${APP_DIR}
RUN pnpm run build

FROM nginx:1.27-alpine
ARG APP_DIR
COPY --from=builder ["/ws/${APP_DIR}/dist", "/usr/share/nginx/html"]
RUN printf 'server {\n\
    listen 8080;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/javascript;\n\
}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
