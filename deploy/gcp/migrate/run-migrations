#!/bin/sh
# ============================================================================
# Aplica las migraciones de backend/db/migrations en orden, UNA sola vez cada
# una. Corre como Cloud Run Job dentro de la VPC (Cloud SQL solo tiene IP
# privada), antes de cada despliegue del backend.
#
#   - Registra cada migración aplicada en `schema_migrations`.
#   - Cada fichero va en su propia transacción (psql -1) con ON_ERROR_STOP: si
#     falla, no queda a medias ni se marca como aplicada, y el job sale con
#     error, lo que detiene el despliegue del backend.
#   - Un advisory lock impide que dos despliegues simultáneos migren a la vez.
# ============================================================================
set -eu
: "${DATABASE_URL:?DATABASE_URL no está definida}"
DIR="${MIGRATIONS_DIR:-/migrations}"

export PGOPTIONS="${PGOPTIONS:-} -c client_min_messages=warning"
psql_() { psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -X -q "$@"; }

psql_ -c "CREATE TABLE IF NOT EXISTS schema_migrations (
            filename   TEXT PRIMARY KEY,
            applied_at TIMESTAMPTZ NOT NULL DEFAULT now())"

aplicadas=0
for f in $(ls "$DIR"/*.sql | sort); do
  nombre=$(basename "$f")
  ya=$(psql_ -At -c "SELECT 1 FROM schema_migrations WHERE filename = '$nombre'")
  if [ "$ya" = 1 ]; then
    echo "= $nombre (ya aplicada)"
    continue
  fi
  echo "→ $nombre"
  # El INSERT va en la misma transacción que la migración.
  { echo "DO \$\$ BEGIN PERFORM pg_advisory_xact_lock(727274); END \$\$;"
    cat "$f"
    echo ";"
    echo "INSERT INTO schema_migrations (filename) VALUES ('$nombre');"
  } | psql_ -1
  aplicadas=$((aplicadas + 1))
done
echo "✅ Migraciones al día ($aplicadas nuevas)."
