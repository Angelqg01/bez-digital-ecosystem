# ============================================================================
# BeZhas — configuración de despliegue en Google Cloud
# ============================================================================
# Este fichero NO contiene secretos y se versiona. Los secretos van a Secret
# Manager (02-secrets.sh) y el token de Hostinger se pasa por variable de
# entorno en el momento de ejecutar 04-hostinger-dns.sh; nunca se escriben aquí.

PROJECT_ID="project-a2f60001-ecbb-49af-8c2"
REGION="us-central1"
ARTIFACT_REPO="bezhas"

# Dominio público (DNS gestionado en Hostinger)
DOMAIN="bezhas.com"
WWW_HOST="www.bezhas.com"
API_HOST="api.bezhas.com"
MCP_HOST="mcp.bezhas.com"

# Repositorio de GitHub autorizado a desplegar (Workload Identity Federation)
GITHUB_REPO="Angelqg01/bez-digital-ecosystem"

# Servicios de Cloud Run
BACKEND_SERVICE="bezhas-backend"
FRONTEND_SERVICE="bezhas-frontend"
MCP_SERVICE="bezhas-intelligence"

# Cuentas de servicio (una por servicio, mínimo privilegio)
SA_BACKEND="bezhas-backend-run"
SA_FRONTEND="bezhas-frontend-run"
SA_MCP="bezhas-mcp-run"
SA_DEPLOYER="bezhas-deployer"

# Balanceador HTTPS global
LB_IP_NAME="bezhas-lb-ip"
LB_NAME="bezhas-lb"
CERT_NAME="bezhas-cert"
ARMOR_POLICY="bezhas-armor"
