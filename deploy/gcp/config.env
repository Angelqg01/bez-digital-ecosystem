# ============================================================================
# BeZhas Blockchain — configuración de despliegue en Google Cloud
# ============================================================================
# Este fichero NO contiene secretos y se versiona. Los secretos van a Secret
# Manager (02-secrets.sh) y el token de Hostinger se pide sin eco al ejecutar
# 04-hostinger-dns.sh; nunca se escriben aquí.

PROJECT_ID="project-a2f60001-ecbb-49af-8c2"
REGION="us-central1"
ARTIFACT_REPO="bezhas"

# Dominio público (DNS gestionado en Hostinger)
DOMAIN="bezhas.com"
WWW_HOST="www.bezhas.com"
API_HOST="api.bezhas.com"
MCP_HOST="mcp.bezhas.com"

# Repositorio de GitHub autorizado a desplegar (Workload Identity Federation)
GITHUB_REPO="Angelqg01/bez-digital-ecosystem"

# Servicios de Cloud Run
#   públicos (detrás del balanceador): control-center (www) y api (api + mcp)
#   privados (solo con token OIDC de otra cuenta de servicio): aegis,
#   ai-gateway, agent-runtime
#   edge-node: sin dominio propio; solo lo llaman los servicios internos
FRONTEND_SERVICE="bezhas-control-center"
BACKEND_SERVICE="bezhas-api"
MCP_SERVICE="bezhas-api"          # el MCP vive en la api (/mcp, /oauth, /.well-known)
AEGIS_SERVICE="bezhas-aegis"
AIGW_SERVICE="bezhas-ai-gateway"
AGENT_SERVICE="bezhas-agent-runtime"
EDGE_SERVICE="bezhas-edge-node"

# Los secretos de esta plataforma llevan prefijo para no chocar con los de la
# versión anterior (BeZhas Hub) que ya están en Secret Manager: los dos juegos
# conviven y se puede volver atrás sin tocar nada.
SECRET_PREFIX="BC_"

# Cuentas de servicio (una por papel, mínimo privilegio)
SA_BACKEND="bezhas-backend-run"   # bezhas-api y el job de migraciones
SA_FRONTEND="bezhas-frontend-run" # bezhas-control-center
SA_MCP="bezhas-mcp-run"           # aegis, ai-gateway y agent-runtime
SA_EDGE="bezhas-edge-run"         # bezhas-edge-node
SA_DEPLOYER="bezhas-deployer"

# Balanceador HTTPS global (ya creado: se reutiliza tal cual)
LB_IP_NAME="bezhas-lb-ip"
LB_NAME="bezhas-lb"
# Prefijo: un certificado por dominio (bezhas-cert-apex, -www, -api, -mcp)
CERT_NAME="bezhas-cert"
ARMOR_POLICY="bezhas-armor"

# Cloud SQL (PostgreSQL) — la instancia es la misma; la base de datos y el
# usuario son nuevos (la plataforma nueva tiene otro esquema).
SQL_INSTANCE="bezhas-pg"
SQL_DATABASE="bezhas_control"
SQL_USER="bezhas_control"
# db-custom-1-3840 = 1 vCPU / 3,75 GB (dedicado). Para empezar más barato:
# DB_TIER=db-g1-small ./deploy/gcp/01b-database.sh  (núcleo compartido, sin SLA)
SQL_TIER="db-custom-1-3840"
VPC_NETWORK="default"
VPC_SUBNET="default"
