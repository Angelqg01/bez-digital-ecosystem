# Secretos de Secret Manager que usan los servicios de Cloud Run.
# Formato: NOMBRE  servicios-que-lo-leen (backend, mcp)  obligatorio|opcional
# 02-secrets.sh crea cada uno y da acceso SOLO a la cuenta de servicio que lo lee.
# Un secreto "opcional" sin valor se crea vacío (sin versión) y el despliegue
# no lo monta: la variable simplemente no existe en el contenedor.

# --- Núcleo / seguridad ---
JWT_SECRET                  backend       obligatorio
COOKIE_SECRET               backend       obligatorio
ADMIN_TOKEN                 backend       obligatorio
CONTACT_ENCRYPTION_KEY      backend       obligatorio
ALLOWED_ORIGINS             backend       obligatorio
# Estos cinco tienen en el código un valor por defecto CONOCIDO o aleatorio por
# instancia; en producción eso es una vulnerabilidad o una pérdida de datos:
#   JWT_REFRESH_SECRET     → 'refresh-secret-change-me': tokens de sesión falsificables
#   INTERNAL_API_KEY       → 'dev-internal-key': API interna de agentes abierta
#   ENCRYPTION_MASTER_KEY  → aleatoria al arrancar: lo cifrado no se lee tras reiniciar
#   WATCHDOG_SUBJECT_SALT  → aleatoria por instancia: el vigilante no correlaciona
#   SUBSCRIPTION_SIGNATURE_SECRET → aleatoria: firmas de suscripción inválidas entre instancias
# 00-generar-env.sh los genera al azar; nunca los escribas a mano.
JWT_REFRESH_SECRET          backend       obligatorio
INTERNAL_API_KEY            backend       obligatorio
ENCRYPTION_MASTER_KEY       backend       obligatorio
WATCHDOG_SUBJECT_SALT       backend       obligatorio
SUBSCRIPTION_SIGNATURE_SECRET backend     obligatorio
# Panel AdminJS: sin ADMIN_PASSWORD usa 'BeZhas2024!Secure', que está en el código.
ADMIN_EMAIL                 backend       obligatorio
ADMIN_PASSWORD              backend       obligatorio
ADMIN_SECRET                backend       opcional

# --- Datos ---
# DATABASE_URL lo crea 01b-database.sh (Cloud SQL); no lo pongas en el .env.
DATABASE_URL                backend       obligatorio
# MongoDB es opcional: sin él, el backend arranca sin Developer Console ni SDK Admin.
MONGODB_URI                 backend,mcp   opcional
REDIS_URL                   backend       opcional

# --- Blockchain / Tokenomics ---
POLYGON_RPC_URL             backend,mcp   obligatorio
# Sin relayer el backend arranca en modo solo lectura (no firma transacciones).
# Debe ser una wallet DEDICADA con poco saldo y solo los roles que necesite.
RELAYER_PRIVATE_KEY         backend       opcional
BEZCOIN_CONTRACT_ADDRESS    backend,mcp   obligatorio
CORE_CONTRACT_ADDRESS       backend       opcional
GOVERNANCE_CONTRACT_ADDRESS backend       opcional
FARMING_CONTRACT_ADDRESS    backend       opcional
MARKETPLACE_CONTRACT_ADDRESS backend      opcional
QUALITY_ESCROW_ADDRESS      backend       opcional
QUALITY_ORACLE_ADDRESS      backend,mcp   opcional
TREASURY_WALLET             backend       obligatorio
COMMUNITY_WALLET            backend       opcional
SUPER_ADMIN_WALLETS         backend       obligatorio
ADMIN_WALLETS               backend       opcional

# Wallet caliente de la pasarela fiat/BezPay: paga gas y reparte BEZ.
# DEDICADA, con saldo mínimo y SIN roles de admin: nunca la del tesoro ni la
# de un super-admin (02-secrets.sh rechaza que coincida con RELAYER).
HOT_WALLET_PRIVATE_KEY      backend       opcional
# Direcciones públicas de contratos (no son secretos; se cargan aquí para no
# fijarlas en el código mientras no estén verificadas en Polygonscan).
BEZCOIN_ADDRESS             backend       opcional
BEZHAS_CORE_ADDRESS         backend       opcional
GOVERNANCE_SYSTEM_ADDRESS   backend       opcional
LIQUIDITY_FARMING_ADDRESS   backend       opcional
NFT_OFFERS_ADDRESS          backend       opcional
NFT_RENTAL_ADDRESS          backend       opcional
BEZHAS_MARKETPLACE_ADDRESS  backend       opcional
SAFE_ADDRESS                backend       opcional

# --- Pagos ---
STRIPE_SECRET_KEY           backend       obligatorio
STRIPE_WEBHOOK_SECRET       backend       obligatorio

# --- OAuth ---
GOOGLE_CLIENT_ID            backend       opcional
GOOGLE_CLIENT_SECRET        backend       opcional
GITHUB_CLIENT_ID            backend       opcional
GITHUB_CLIENT_SECRET        backend       opcional
LINKEDIN_CLIENT_ID          backend       opcional
LINKEDIN_CLIENT_SECRET      backend       opcional

# --- OAuth 2.1 del MCP público (Claude, Codex, Gemini) ---
# Par ES256 PROPIO, no JWT_SECRET. En el .env van como PEM en base64 de UNA
# línea (el parser de 02-secrets.sh lee línea a línea):
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt > priv.pem
#   openssl ec -in priv.pem -pubout > pub.pem
#   OAUTH_JWT_PRIVATE_KEY=$(base64 -w0 priv.pem)   OAUTH_JWT_PUBLIC_KEY=$(base64 -w0 pub.pem)
# El backend firma y NO arranca sin el par; el MCP sólo recibe la pública.
OAUTH_JWT_PRIVATE_KEY       backend       obligatorio
OAUTH_JWT_PUBLIC_KEY        backend,mcp   obligatorio

STRIPE_PUBLISHABLE_KEY      backend       opcional
MOONPAY_SECRET_KEY          backend       opcional

# --- IA / IPFS / notificaciones ---
ANTHROPIC_API_KEY           backend       opcional
TELEGRAM_SECURITY_CHAT_ID   backend       opcional
SLACK_WEBHOOK_URL           backend       opcional
GEMINI_API_KEY              backend       opcional
OPENAI_API_KEY              backend       opcional
DEEPSEEK_API_KEY            backend       opcional
PINATA_API_KEY              backend       opcional
PINATA_SECRET_KEY           backend       opcional
TELEGRAM_BOT_TOKEN          backend       opcional
DISCORD_WEBHOOK_URL         backend       opcional

# --- MCP Intelligence ---
GITHUB_TOKEN                mcp           opcional
FIRECRAWL_API_KEY           mcp           opcional
TALLY_API_KEY               mcp           opcional
ALPACA_API_KEY              mcp           opcional
ALPACA_SECRET_KEY           mcp           opcional
ONEINCH_API_KEY             mcp           opcional
