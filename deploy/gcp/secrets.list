# Secretos de Secret Manager que usan los servicios de Cloud Run.
#
# Formato:  NOMBRE  servicios  obligatorio|opcional  [variables]
#   NOMBRE     clave en ~/bezhas-blockchain.env. En Secret Manager se guarda
#              como ${SECRET_PREFIX}NOMBRE (BC_JWT_SECRET…) para no pisar los
#              secretos de la versión anterior de la plataforma.
#   servicios  quién lo lee: api, web (control-center), aegis, aigw
#              (ai-gateway), agent (agent-runtime), edge (edge-node).
#              02-secrets.sh da acceso SOLO a sus cuentas de servicio.
#   variables  (opcional) nombres con los que se monta en el contenedor,
#              separados por comas. Por defecto, el propio NOMBRE.
#
# Un secreto "opcional" sin valor se crea vacío (sin versión) y el despliegue
# no lo monta: la variable simplemente no existe en el contenedor.
# 00-generar-env.sh genera al azar todos los internos; nunca los escribas a mano.

# --- Núcleo / sesión ---
# JWT_SECRET lo comparten api y control-center: el panel verifica en el
# servidor los tokens que emite la api.
JWT_SECRET                  api,web                   obligatorio
INTERNAL_API_KEY            api,aegis,aigw,agent      obligatorio
# Cifrado en reposo. Tres claves DISTINTAS (walletVaultService rechaza que el
# vault reutilice JWT_SECRET o INTERNAL_API_KEY y exige ≥ 32 caracteres):
#   WALLET_VAULT_SECRET     → claves de las wallets custodiadas (alta FIAT)
#   SECRET_VAULT_KEY        → credenciales de terceros guardadas (POS, ERP)
#   TELEMETRY_PSEUDONYM_KEY → seudónimos de la telemetría (RGPD)
# Perderlas = no poder descifrar lo guardado: haz copia fuera de GCP.
WALLET_VAULT_SECRET         api                       obligatorio
SECRET_VAULT_KEY            api                       obligatorio
TELEMETRY_PSEUDONYM_KEY     api                       obligatorio

# --- OAuth 2.1 del MCP público (Claude, ChatGPT, Codex, Gemini) ---
# Par ES256 PROPIO (no JWT_SECRET), PEM en base64 de UNA línea. Sin el par la
# api no arranca en producción.
OAUTH_JWT_PRIVATE_KEY       api                       obligatorio
OAUTH_JWT_PUBLIC_KEY        api                       obligatorio

# --- Panel de administración ---
# Sin estos dos el login por credenciales queda CERRADO (no abierto).
# ADMIN_PASSWORD_HASH es bcrypt; 00-generar-env.sh lo calcula y la contraseña
# en claro se queda solo en tu .env (ADMIN_PASSWORD, que no se sube).
ADMIN_USERNAME              api                       obligatorio
ADMIN_PASSWORD_HASH         api                       obligatorio
# Token del War Room (/api/monitor): lo envía el control-center a la api.
MONITOR_ACCESS_TOKEN        api,web                   opcional

# --- Datos ---
# DATABASE_URL lo crea 01b-database.sh (Cloud SQL); no lo pongas en el .env.
DATABASE_URL                api                       obligatorio
# Sin Redis la api degrada con elegancia (caché en memoria, sin colas).
REDIS_URL                   api,agent                 opcional

# --- Blockchain / Tokenomics ---
# URLs de RPC: suelen llevar la API key del proveedor (Alchemy, Infura…).
POLYGON_RPC_URL             api                       opcional
RPC_URL                     api,agent,edge            opcional
# RPC de la cadena con la que opera la api (BEZHAS_CHAIN_ID en cloudbuild.yaml):
# Polygon mainnet mientras no haya nodo de la L2 propia (chain 2708).
BEZHAS_L2_RPC_URL           api                       opcional
# Wallets calientes: DEDICADAS, con saldo mínimo y SIN roles de admin.
# Nunca la del tesoro, la del deployer de los contratos ni la de la multisig
# (hotKeyGuard las descarta al arrancar y 02-secrets.sh rechaza duplicados).
# Sin ellas la plataforma arranca en modo solo lectura.
OPERATOR_PRIVATE_KEY        api                       opcional
AGENT_PRIVATE_KEY           agent                     opcional
EDGE_NODE_PRIVATE_KEY       edge                      opcional      PRIVATE_KEY
TREASURY_WALLET             api                       opcional
BRIDGE_API_KEY              api                       opcional

# --- Pagos ---
# Webhook de Stripe → https://api.bezhas.com/api/webhooks/stripe
STRIPE_SECRET_KEY           api                       opcional
STRIPE_WEBHOOK_SECRET       api                       opcional
BANK_WEBHOOK_SECRET         api                       opcional

# --- IA / IPFS / correo ---
GEMINI_API_KEY              api,agent                 opcional
DEEPSEEK_API_KEY            api                       opcional
ANTHROPIC_API_KEY           agent                     opcional
PINATA_JWT                  api                       opcional
SMTP_PASS                   api                       opcional

# --- Agentes ---
AGENT_RUNTIME_API_KEY       agent                     opcional
TELEGRAM_BOT_TOKEN          agent                     opcional
TELEGRAM_SECURITY_CHAT_ID   agent                     opcional
DISCORD_BOT_TOKEN           agent                     opcional

# --- Edge node ---
# Una sola clave; el edge-node la lee con dos nombres.
EDGE_NODE_API_KEY           edge                      obligatorio   EDGE_NODE_API_KEY,API_KEY
CONTROL_JWT                 edge                      obligatorio
