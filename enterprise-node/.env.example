# ─────────────────────────────────────────────
#  BeZhas Enterprise Node — Environment Config
# ─────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=bezhas
POSTGRES_PASSWORD=CHANGE_ME_enterprise_2024
POSTGRES_DB=bezhas_enterprise

# ── Enterprise API ──
PORT=4100
NODE_ENV=production
# API key required for webhook endpoints (B2B auth)
API_KEY=CHANGE_ME_your_api_key
PUBLIC_API_URL=http://localhost:4100
PUBLIC_RPC_URL=http://localhost:8545
PUBLIC_EXPLORER_URL=http://localhost:4000
PUBLIC_CHAIN_NAME=BeZhas L2

# ── Blockchain Connection ──
# Internal connection used by the API to reach the local geth node
BEZHAS_L2_RPC_URL=http://bezhas-geth:8545
# Chain ID for BeZhas L2
CHAIN_ID=2708

# ── RPC Exposure / Security ──
# Safe default: bind RPC to localhost only. Use 0.0.0.0 only behind firewall,
# VPN, or a reverse proxy with rate limiting and origin controls.
RPC_HTTP_BIND=127.0.0.1
RPC_WS_BIND=127.0.0.1
RPC_CORS_ORIGINS=http://localhost:3000,http://localhost:4100
RPC_WS_ORIGINS=http://localhost:3000,http://localhost:4100
RPC_VHOSTS=localhost,127.0.0.1,bezhas-geth

# ── ABI Sync (optional — fetches latest ABIs from BeZhas platform) ──
# Leave empty to use bundled ABIs
BEZHAS_PLATFORM_API=https://api.bezhas.io
BEZHAS_PLATFORM_API_KEY=
# Docker compose mounts ../sdk at /bezhas-sdk. For local node server.js, use ../sdk.
BEZHAS_SDK_PATH=/bezhas-sdk

# ── Tokenomics Contract Overrides ──
BEZCOINV2_ADDRESS=
STAKING_POOL_ADDRESS=
LIQUIDITY_FARMING_ADDRESS=
GOVERNANCE_SYSTEM_ADDRESS=
QUALITY_ESCROW_ADDRESS=
BEZHAS_QUALITY_ESCROW_ADDRESS=
VALIDATOR_REGISTRY_ADDRESS=
EDGE_NODE_REWARDS_ADDRESS=

# ── Validator (optional — register as validator node) ──
VALIDATOR_PRIVATE_KEY=
VALIDATOR_ADDRESS=
VALIDATOR_COMPANY_NAME=BeZhas Enterprise Node
VALIDATOR_STAKE_AMOUNT_BEZ=0

# ── Profitability Model Defaults ──
REVENUE_MONTHLY_NODE_FEE_EUR=199
REVENUE_SETUP_FEE_EUR=999
REVENUE_WEBHOOK_FEE_EUR=0.01
REVENUE_INDEXED_EVENT_FEE_EUR=0.001
REVENUE_VALIDATOR_REWARD_BEZ_MONTHLY=0
BEZ_PRICE_EUR=0.05
INFRA_COST_EUR_MONTHLY=60
EST_INDEXED_EVENTS_MONTHLY=50000
EST_WEBHOOKS_MONTHLY=10000
EST_ENTERPRISE_CLIENTS=1
HOOK_TIMEOUT_MS=8000

# ── Control API (subscription tier gate for /webhook) ──
CONTROL_API_URL=http://localhost:3001
CONTROL_JWT=

# ── OP Stack L2 Settings ──
# L1 RPC for the consensus node (Sepolia by default)
L1_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# Sequencer endpoint (BeZhas central sequencer)
SEQUENCER_URL=https://sequencer.bezhas.io
