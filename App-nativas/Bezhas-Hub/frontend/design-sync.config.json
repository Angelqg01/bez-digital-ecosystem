    "CardFooter": "src/components/ui/Card.jsx",
    "Badge": "src/components/ui/Badge.jsx",
    "Input": "src/components/ui/Input.jsx",
    "Label": "src/components/ui/Label.jsx",
    "Spinner": "src/components/ui/Spinner.jsx",
    "BezCoinLoader": "src/components/ui/BezCoinLoader.jsx",
