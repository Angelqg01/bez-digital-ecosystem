{
  "name": "@bezhas/mcp-server",
  "version": "1.0.0",
  "description": "BeZhas Intelligence - MCP Server for AI-driven Web3 decisions",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http-server.ts",
    "lint": "eslint src/",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "ethers": "^6.13.4",
    "zod": "^4.6.5",
    "express": "^5.2.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "mongoose": "^9.11.0",
    "pino": "^10.4.0",
    "axios": "^1.18.0",
    "express-rate-limit": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "typescript": "^7.0.2",
    "tsx": "^4.19.2",
    "vitest": "^5.0.3",
    "supertest": "^7.1.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "pnpm": ">=11"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "pnpm": {
    "overrides": {
      "path-to-regexp@<1": "^0.1.13",
      "path-to-regexp@>=8": "^8.4.0",
      "ws": "^8.21.0",
      "fast-uri": "^3.1.6",
      "ip-address": "^10.3.1",
      "ajv": "^8.18.0",
      "qs": "^6.16.0",
      "body-parser@<2": "^1.20.6",
      "express-rate-limit": "^8.2.2",
      "hono": "^4.13.5",
      "@hono/node-server": "^1.19.15"
    }
  }
}
