# ═══════════════════════════════════════════════
# BeZhas Intelligence MCP Server - Environment
# ═══════════════════════════════════════════════

# Polygon RPC
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Network Mode: mainnet | amoy | localhost
NETWORK_MODE=amoy

# Relayer (Gasless Transactions for ToolBEZ IoT)
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=

# MongoDB (for KYC/compliance lookups)
MONGODB_URI=mongodb://localhost:27017/bezhas

# Stripe (for fiat swap calculations)
STRIPE_FEE_PERCENT=2.9
STRIPE_FEE_FIXED_CENTS=30

# BEZ Token Config
BEZ_CONTRACT_ADDRESS=0xEcBa873B534C54DE2B62acDE232ADCa4369f11A8
BEZ_PRICE_USD=0.0075

# Oráculo de tasas de referencia
#
# El cambio de cada cripto y divisa se consulta al mercado y se refresca cada
# media hora. Las constantes REFERENCE_RATE_* son solo la reserva para cuando
# el mercado no responde: no son el precio.
REFERENCE_RATES_TTL_MS=1800000
REFERENCE_RATES_MAX_AGE_MS=3600000
REFERENCE_RATES_TIMEOUT_MS=8000
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# REFERENCE_RATE_MATIC=0.8
# REFERENCE_RATE_ETH=2400
# REFERENCE_RATE_BTC=45000
# REFERENCE_RATE_BNB=430
# REFERENCE_RATE_EUR=1.08
# REFERENCE_RATE_GBP=1.27
# REFERENCE_RATE_MXN=0.0583

# Platform Fees
PLATFORM_FEE_PERCENT=1.0
FEE_BURN_PERCENT=50

# HTTP Server (for Docker/Backend communication)
HTTP_PORT=8080

# MCP público con OAuth 2.1 (POST /mcp). El servidor de autorización es el
# backend; aquí sólo se verifica la firma con la clave pública ES256.
OAUTH_ISSUER=https://api.bezhas.com
MCP_PUBLIC_URL=https://mcp.bezhas.com
# PEM o PEM en base64. Sin ella se usa el JWKS de ${OAUTH_ISSUER}/.well-known/jwks.json
OAUTH_JWT_PUBLIC_KEY=
# OAUTH_JWKS_URL=
# MCP_PUBLIC_LIMIT_PER_MINUTE=120
