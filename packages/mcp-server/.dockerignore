# Lo que no debe entrar en el contexto de construcción.
#
# `dist/` se excluye a propósito: la imagen lo compila dentro. Si se colase el
# de la máquina de quien construye, la imagen llevaría un compilado viejo sin
# que nada lo delatase.
node_modules
dist
build

