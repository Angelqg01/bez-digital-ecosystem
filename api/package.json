{
  "name": "bezhas-api",
  "version": "1.0.0",
  "description": "BeZhas Web3 Platform API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "node db/migrate.js",
    "db:migrate:reset": "node db/migrate.js --reset",
    "db:seed": "node db/seed.js",
    "db:setup": "node db/migrate.js && node db/seed.js",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns /node_modules/ __tests__/e2e/ __tests__/integration/",
    "test:e2e": "jest __tests__/e2e __tests__/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@babel/traverse": "^7.29.0",
    "@google-cloud/logging": "^11.1.0",
    "@google-cloud/pubsub": "^4.5.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^7.10.0",
    "@noble/post-quantum": "^0.6.1",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.6",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "morgan": "^1.12.0",
    "mqtt": "^5.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "redis": "^4.6.10",
    "stripe": "^17.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tslib": "^2.6.2",
    "uuid": "^13.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@eslint/js": "^8.55.0",
    "aedes": "^1.0.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "lru-cache": "11.5.2",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "web3",
    "blockchain",
    "nft",
    "defi",
    "api",
    "ethereum"
  ],
  "author": "BeZhas Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.0.0"
}
