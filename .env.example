# ═══════════════════════════════════════════════════════
#  BeZhas Blockchain — Production Environment Config
# ═══════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.
#

# ─── CHAIN CONFIG ────────────────────────────────────
# BSC Mainnet = 56, BSC Testnet = 97, Local = 31337
BEZHAS_CHAIN_ID=56
RPC_URL=https://bsc-dataseed.binance.org/

# ─── BEZ TOKEN (v1 — LIVE) ──────────────────────────
# BEZ-Coin v1 on BSC Mainnet / BNB Chain
# BEZCoinV2 is NOT deployed yet — do NOT change this until L2 launch
BEZ_TOKEN_ADDRESS=0x8a1e3930fde1f151471c368fdbb39f3f63a65b55

# ─── TREASURY / ADMIN ───────────────────────────────
# Private key of the treasury wallet (used for minting/transfers)
# KEEP THIS SECRET — never share or commit
BEZ_TREASURY_PK=
ADMIN_PK=

# ─── STRIPE PAYMENTS ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Frontend (Vite) — clave publicable, usada por el Settings de organización
# (pestaña Facturación) para capturar tarjeta/SEPA con Stripe Elements. Es
# pública por diseño: va en el bundle del navegador, nunca la secret key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx

# ─── BANK TRANSFER WEBHOOK ──────────────────────────
BANK_WEBHOOK_SECRET=

# ─── API GATEWAY ─────────────────────────────────────
BRIDGE_API_KEY=
INTERNAL_API_KEY=
JWT_SECRET=
JWT_ISSUER=bezhas-gateway

# ── Credenciales SuperAdmin (panel /admin) ──
# Sin fallback en el código: si estas dos quedan vacías, POST /api/admin-auth/login
# responde 503 y el panel queda cerrado. Es intencionado.
# Generar el hash (coste 12):
#   cd api && node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'TU_PASSWORD'
# Poner el hash ENTRE COMILLAS SIMPLES: bcrypt contiene '$' y sin comillas hay
# parsers de .env que lo expanden como variable y lo corrompen.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Dominio de la cookie de sesión admin (HttpOnly). Vacío en local, donde API y
# panel comparten el host `localhost`. En producción viven en subdominios
# distintos y sin esto la cookie no sale del host de la API:
#   COOKIE_DOMAIN=.bez.digital
COOKIE_DOMAIN=

# Clave del almacén cifrado (aes-256-gcm): protege los secretos de
# identity_secrets y el secreto TOTP del SuperAdmin. Sin ella el código genera
# una clave efímera por arranque, así que nada de lo cifrado sobrevive a un
# reinicio — incluido el segundo factor del administrador.
#   openssl rand -hex 32
VAULT_KEY=

# Exigir segundo factor (TOTP) en el login de administrador. Con `false` el
# login sigue siendo usuario+contraseña; con `true`, el primer acceso guía el
# alta del 2FA antes de abrir sesión.
ADMIN_2FA_REQUIRED=false

# Token del War Room (/monitor). Esa pantalla vive fuera del árbol autenticado
# para que un kiosko sin login pueda cargarla, así que este token es lo único
# que la separa de internet. Sin configurar, /api/monitor responde 503 en prod.
#   openssl rand -hex 32
MONITOR_ACCESS_TOKEN=

# ─── DATABASE ────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/bezhas
REDIS_URL=redis://localhost:6379

# ─── SERVICES ────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ─── GCP DEPLOYMENT ──────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
PUBLIC_SITE_URL=https://bez.digital
APP_SITE_URL=https://app.bez.digital
GCS_BUCKET=bezhas-assets-prod
RUN_DB_MIGRATIONS=true

# Set true only when the Cloud Run edge node should sign transactions directly.
DEPLOY_EDGE_SIGNER=false
# Bearer token con el que los edge nodes llaman a /api/agent (ver
# unified-agent.js). validate-env.sh falla si sigue siendo el placeholder.
#   node -e "console.log('bez_edge_'+require('crypto').randomBytes(24).toString('hex'))"
EDGE_NODE_API_KEY=
CONTROL_JWT=
EDGE_NODE_PRIVATE_KEY=
ESCROW_CONTRACT_ADDRESS=

# ─── BRIDGE RELAY ────────────────────────────────────
# Required only if running the bridge relay service
L2_RPC_URL=http://localhost:8545
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
RELAY_PRIVATE_KEY=
BRIDGE_L2_ADDRESS=
WRAPPED_BEZ_ADDRESS=

# ─── MINTING CONFIG ─────────────────────────────────
BEZ_PRICE_USD_CENTS=7
MINT_GAS_LIMIT=200000
TX_WAIT_TIMEOUT_MS=180000

# ─── SUBAPP FRONTEND ────────────────────────────────
# Set these in each SubApp's .env or .env.local
# VITE_API_URL=http://localhost:3001/api
# VITE_RPC_URL=https://bsc-dataseed.binance.org/
# VITE_CHAIN_ID=56
# VITE_WALLET_URL=http://localhost:5174

# ═══════════════════════════════════════════════════════════════════════════
# Claves añadidas para PARIDAD con .env (rellenar vía GCP Secret Manager)
# NUNCA poner valores reales aquí. Solo placeholders.
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de datos / cache ──
POSTGRES_USER=bezhas
POSTGRES_PASSWORD=<changeme>
POSTGRES_DB=bezhas_control

# ── Proveedores IA ──
DEEPSEEK_API_KEY=<changeme>
GEMINI_API_KEY=<changeme>
GEMINI_API_KEY_ALT=<changeme>
OPENAI_API_KEY=<changeme>

# ── Telegram ──
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<changeme>
TELEGRAM_TOKEN_DIRECTOR=<changeme>
TELEGRAM_TOKEN_FINANCE=<changeme>
TELEGRAM_TOKEN_MARKETING=<changeme>
TELEGRAM_TOKEN_DEVOPS=<changeme>
TELEGRAM_TOKEN_LEGAL=<changeme>

# ── OAuth / SSO ──
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: el login del Hub ya no usa esto — se
# retiró el botón de Google del registro/login (decisión de producto: solo
# email/contraseña, wallet y LinkedIn). La ruta backend /api/auth/google sigue
# viva pero inalcanzable desde ninguna UI; no hace falta rellenar estas claves.
GOOGLE_CLIENT_ID=<changeme>
GOOGLE_CLIENT_SECRET=<changeme>
GITHUB_CLIENT_ID=<changeme>
GITHUB_CLIENT_SECRET=<changeme>
STRIPE_PUBLISHABLE_KEY=<changeme>
HUBSPOT_ACCESS_TOKEN=<changeme>

# ── LinkedIn ──
# Mismas credenciales para dos usos: "Sign In with LinkedIn using OpenID
# Connect" (login real de usuarios, App-nativas/Bezhas-Hub/backend/routes/auth.routes.js)
# y la integración de marketing/posting (integrations/linkedin/LinkedInClient.js).
# El login exige que el producto de LinkedIn "Sign In with LinkedIn using OpenID
# Connect" esté habilitado en la misma App de LinkedIn Developers.
LINKEDIN_CLIENT_ID=<changeme>
LINKEDIN_CLIENT_SECRET=<changeme>
LINKEDIN_REDIRECT_URI=https://<changeme>/callback
LINKEDIN_SCOPES=r_liteprofile,w_member_social
LINKEDIN_API_VERSION=202401
LINKEDIN_DRY_RUN=true
LINKEDIN_REPORT_DIR=./reports/linkedin
LINKEDIN_ORGANIZATION_ID=<changeme>
LINKEDIN_ACCESS_TOKEN=<changeme>

# Frontend del Hub (Vite) — cliente público de LinkedIn para el botón de login,
# mismo valor que LINKEDIN_CLIENT_ID (es público por diseño en OAuth Authorization Code).
VITE_LINKEDIN_CLIENT_ID=<changeme>

# ── Blockchain / wallets (usar Secret Manager / KMS en prod) ──
POLYGON_CHAIN_ID=137
BEZHAS_L2_RPC_URL=https://<changeme>
AEGIS_API_URL=https://<changeme>
BEZCOIN_ADDRESS=0x<address>
BEZCOIN_MULTISIG_ADDRESS=0x<address>
BEZCOIN_LP_POOL=0x<address>
BEZHAS_MULTISIG_WALLET=0x<address>
ADMIN_WALLET=0x<address>
EDGE_NODE_ADDRESS=0x<address>
DEPLOYER_PRIVATE_KEY=0x<your_64_hex_private_key>
BATCHER_PRIVATE_KEY=0x<your_64_hex_private_key>

# ── OPERANT (SubApp de gestión empresarial autónoma) ──────────────────────────
# El runtime de agentes corre como servicio aparte; la API de BeZhas lo consume
# por el puente interno. Sin OPERANT_INTERNAL_KEY la SubApp queda desactivada
# (las rutas responden 503 diciendo por qué), nunca a medias.
OPERANT_API_URL=http://localhost:3010
OPERANT_INTERNAL_KEY=<misma_clave_que_INTERNAL_API_KEY_en_operant>
OPERANT_TIMEOUT_MS=20000
OPERANT_FAILURE_THRESHOLD=3
OPERANT_COOLDOWN_MS=60000
# Firma las anclas merkle de la auditoría. Si no está, el ancla se calcula y se
# guarda igual (tx_hash nulo) y se reintenta: la raíz nunca se pierde.
OPERANT_OPERATOR_KEY=0x<your_64_hex_private_key>

# ── Oraculo de precio publico (GET /api/gateway/v1/oracle/token-prices) ──
# Ventana de frescura en segundos. Fuera de ella la landing marca la lectura
# como obsoleta en vez de presentarla como vigente (regla fail-closed).
ORACLE_FRESHNESS_WINDOW_S=900
# Memo en proceso del precio, en ms. 0 lo desactiva.
ORACLE_PRICE_TTL_MS=15000
# Peticiones por minuto e IP al endpoint publico de precio.
ORACLE_PRICE_RATE_LIMIT=120

# ─── SECRETOS EXIGIDOS POR docker-compose.yml ────────────────────────────────
# Estos valores estaban escritos como valor por defecto (`${VAR:-...}`) dentro
# de docker-compose.yml, que está versionado. Así fue como la contraseña de
# Postgres acabó siendo el marcador de posición de la documentación: bastaba
# arrancar sin .env para que el volumen se inicializara con una credencial
# publicada, y a partir de ahí quedaba fija.
#
# Ahora el compose las declara con `${VAR:?...}` y aborta con un mensaje claro
# si faltan, en lugar de inventarse una credencial conocida.
#
# ATENCIÓN al rotarlas: Postgres y Grafana fijan su contraseña en el PRIMER
# arranque y luego ignoran la variable. Cambiar el valor aquí no cambia la
# credencial real del volumen — solo cambia con cuál intentan conectarse los
# clientes, y el resultado es un fallo de autenticación. Para rotarlas de
# verdad hace falta `ALTER USER` (Postgres) o reprovisionar el servicio.
#   openssl rand -hex 32
OPERANT_ADMIN_KEY=
OPERANT_POSTGRES_PASSWORD=
OPERANT_APP_PASSWORD=
WEBUI_SECRET_KEY=
GRAFANA_PASSWORD=
