{
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "pnpm dlx only-allow pnpm",
    "linkedin:oauth:url": "node scripts/linkedin-oauth-url.js",
    "linkedin:oauth:exchange": "node scripts/linkedin-exchange-token.js",
    "linkedin:oauth:exchange:write": "node scripts/linkedin-exchange-token.js --write-env",
    "linkedin:prospecting": "node scripts/linkedin-prospecting-runner.js --mode prospecting",
    "linkedin:messages": "node scripts/linkedin-prospecting-runner.js --mode messages",
    "generate:subapp-credentials": "node scripts/generate_subapp_credentials.js",
    "security:scan-secrets": "node scripts/security/scan-secrets.cjs",
    "security:preflight-db": "node scripts/db-security-preflight.cjs",
    "security:validate-env": "bash scripts/validate-env.sh",
    "security:check": "pnpm run security:validate-env && pnpm run security:preflight-db",
    "security:compose-defaults": "node scripts/security/check-compose-defaults.cjs",
    "audit:production": "node scripts/production-readiness-audit.cjs",
    "watchdog:subapps": "node scripts/subapp-watchdog.cjs",
    "watchdog:subapps:once": "node scripts/subapp-watchdog.cjs --once",
    "sync:abi": "node scripts/sync-daemon.cjs --once",
    "sync:abi:watch": "node scripts/sync-daemon.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "node-fetch": "^3.3.2",
    "node-telegram-bot-api": "^1.1.0",
    "redis": "^6.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0"
  }
}
