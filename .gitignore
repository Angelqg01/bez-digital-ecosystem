# Environment variables (API keys, secrets)
.env
.env.*
!.env.example
!.env.testnet.example
# nested env files in any subdir (api/, openclaw/, App-nativas/, etc.)
**/.env
**/.env.*
!**/.env.example

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Docker data volumes
pg-data/
geth-data/

# OpenClaw local install
openclaw/node_modules/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.vscode/
/.next/
control-center/frontend/.next/
*.swp
*.swo

# Local sensitive artifacts (never commit)
bezhas_subapp_credentials.txt
Agentes IA MCP.zip
*credentials*.txt
*.key
*.pem
*.p12
*.keystore
secrets.local.*
**/secrets.local.*
# scratch files that have leaked live keys (sanitize+rotate, never commit)
**/Untitled-*.json
**/untitled-*.json

# Foundry broadcast logs may embed RPC URLs / sender keys
smart-contracts/broadcast/
smart-contracts/cache/
smart-contracts/out/
**/broadcast/**/run-*.json

# Foundry dev worktrees (not part of the monorepo)
smart-contracts.worktrees/

# Google Drive sync artifacts
.tmp.driveupload/
**/.tmp.driveupload/
.tmp.drivedownload/
**/.tmp.drivedownload/
*.gdoc
*.gsheet

# Build outputs
dist/
build/
.next/
*.tsbuildinfo

# Rust build artifacts (cargo target dirs)
target/
**/target/

# Turborepo cache
.turbo/
**/.turbo/

# Archives / heavy binaries (never commit)
*.zip
*.tar
*.tar.gz
*.7z
*.bak

# Local runtime data / logs
logs/
*.log
mnt/
status/*.json

# Compose / debugging logs
build-log.txt
docker-build-output.log
.claude/
api/scripts/.cargolink-sim.json

# Copias de seguridad con marca de tiempo. Las generan los scripts de
# despliegue y de rotación de credenciales; no describen ningún estado del
# proyecto y algunas guardan valores que ya se han rotado.
*.bak-*
*.bak
